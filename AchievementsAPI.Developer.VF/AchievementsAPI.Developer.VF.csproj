<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>AchievementsAPI.Developer</AssemblyName>
        <RootNamespace>AchievementsAPI.Developer</RootNamespace>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <DebugType>embedded</DebugType>
        <DefineConstants>$(DefineConstants);VENT_FRAMEWORK</DefineConstants>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix>dev</VersionSuffix>
        <Description>Developer identity plugin for Achievements API</Description>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <IncludeContentInPack>true</IncludeContentInPack>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../LICENSE" Pack="true" PackagePath="" />
        <None Include="../README.md" Pack="true" PackagePath="" />
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.3.31" PrivateAssets="all" />

        <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" ExcludeAssets="runtime" />

        <Compile Include="../AchievementsAPI.Developer/**/*.cs" Exclude="../AchievementsAPI.Developer/obj/**;../AchievementsAPI.Developer/bin/**" />
        <Reference Include="VentFrameworkContinued">
            <HintPath>../lib/VentFrameworkContinued.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../AchievementsAPI.VF/AchievementsAPI.VF.csproj" Private="false" />
    </ItemGroup>

    <Target Name="Copy" AfterTargets="Build" Condition="'$(AmongUsVF)' != ''">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AmongUsVF)/BepInEx/plugins/" UseSymboliclinksIfPossible="true" />
    </Target>
</Project>

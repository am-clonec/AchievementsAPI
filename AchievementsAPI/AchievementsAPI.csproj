<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../AchievementsAPI.Shared.props" />

    <PropertyGroup>
        <PackageId>CloneC.AchievementsAPI</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Reactor" Version="2.5.0-ci.371" />
        <Compile Remove="Backend/VentFramework/**" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\*.bundle" />
    </ItemGroup>

    <Target Name="Copy" AfterTargets="Build" Condition="'$(AmongUs)' != ''">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AmongUs)/BepInEx/plugins/" UseSymboliclinksIfPossible="true" />
    </Target>
</Project>
